generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CursoPeriodo {
  Matutino
  Vespertino
  Noturno
  Integral
}

enum BoletimSituacao {
  NaoCursado
  EmAndamento
  Aprovado
  Reprovado
  EmRecuperacao
  Trancado
}

enum Role {
  admin
  professor
  aluno
}

model Aluno {
  alunoId        String   @id @default(uuid())
  alunoNome      String
  alunoMatricula String   @unique
  alunoEmail     String   @unique
  alunoTelefone  String
  alunoCep       String
  alunoEndereco  String
  alunoCidade    String
  alunoEstado    String
  alunoSemestreAtual Int @default(1)

  cursoId String
  curso   Curso @relation(fields: [cursoId], references: [cursoId])

  boletins Boletim[]

  usuario Usuario? @relation("UsuarioAluno")

  alunoCreatedAt DateTime @default(now())
  visualizacoesAvisos AvisoVisualizacao[]
}

model Professor {
  professorId            String @id @default(uuid())
  professorNome          String
  professorTitulacao     String
  professorAreaAtuacao   String
  professorTempoDocencia Int
  professorEmail         String @unique

  disciplinas Disciplina[]

  usuario Usuario? @relation("UsuarioProfessor")
}

model Curso {
  cursoId              String @id @default(uuid())
  cursoNome            String @unique
  cursoPeriodo         CursoPeriodo
  cursoMediaAprovacao  Float?
  cursoDuracao         Int?

  alunos       Aluno[]
  disciplinas  Disciplina[]

  avisos Aviso[]
}

model Disciplina {
  disciplinaId             String @id @default(uuid())
  disciplinaNome           String
  disciplinaCargaHoraria   Int
  disciplinaSemestre       Int
  disciplinaAtiva Boolean @default(true)

  professorId String
  professor   Professor @relation(fields: [professorId], references: [professorId])

  cursoId String
  curso   Curso @relation(fields: [cursoId], references: [cursoId])

  avisos Aviso[]
  boletins Boletim[]
}

model Boletim {
  boletimId String @id @default(uuid())

  alunoId String
  aluno   Aluno @relation(fields: [alunoId], references: [alunoId])

  disciplinaId String
  disciplina   Disciplina @relation(fields: [disciplinaId], references: [disciplinaId])

  boletimNota1 Float
  boletimNota2 Float
  boletimMedia Float

  boletimSituacao BoletimSituacao

  boletimCreatedAt DateTime @default(now())
}

model Usuario {
  usuarioId    String @id @default(uuid())
  usuarioNome  String
  usuarioEmail String @unique
  usuarioSenha String

  usuarioRole   Role    @default(aluno)
  usuarioAtivo  Boolean @default(true)

  alunoId String? @unique
  aluno   Aluno? @relation("UsuarioAluno", fields: [alunoId], references: [alunoId])

  professorId String? @unique
  professor   Professor? @relation("UsuarioProfessor", fields: [professorId], references: [professorId])

  usuarioCreatedAt DateTime @default(now())
  usuarioUpdatedAt DateTime @updatedAt

  avisosCriados Aviso[]
}

model Aviso {
  avisoId String @id @default(uuid())

  avisoTitulo String
  avisoMensagem String

  avisoAtivo Boolean @default(true)

  criadoPorId String
  criadoPor Usuario @relation(fields: [criadoPorId], references: [usuarioId])

  cursoId String?
  curso Curso? @relation(fields: [cursoId], references: [cursoId])

  disciplinaId String?
  disciplina Disciplina? @relation(fields: [disciplinaId], references: [disciplinaId])

  visualizacoes AvisoVisualizacao[]

  avisoCreatedAt DateTime @default(now())
}

model AvisoVisualizacao {
  avisoVisualizacaoId String @id @default(uuid())

  avisoId String
  aviso Aviso @relation(fields: [avisoId], references: [avisoId])

  alunoId String
  aluno Aluno @relation(fields: [alunoId], references: [alunoId])

  visualizadoEm DateTime @default(now())

  @@unique([avisoId, alunoId])
}